<?php
class Hewan
{
    private $nama;
    private $umur;

    public function __construct($nama, $umur)
    {
        $this->setNama($nama);
        $this->setUmur($umur);
    }

    public function setNama($nama)
    {
        $this->nama = $nama;
    }

    public function getNama()
    {
        return $this->nama;
    }

    public function setUmur($umur)
    {
        $this->umur = $umur;
    }

    public function getUmur()
    {
        return $this->umur;
    }
}

